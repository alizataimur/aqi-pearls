# Copy to .env for local dev. NEVER commit .env (CLAUDE.md I9).
# In CI these live in GitHub Secrets and nowhere else.

# --- Stage 0: required now ----------------------------------------------------
# Free token: https://aqicn.org/data-platform/token/
AQICN_TOKEN=

# --- Stage 0: optional, for failure notifications -----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- D14: citizen-facing hazard alerts -----------------------------------------
# Email is the default channel (docs/DECISIONS.md ADR-032) — Telegram is
# blocked in Pakistan by the PTA, the market this product is for. Telegram
# (above) still works as a channel, e.g. for monitoring from outside Pakistan;
# set ALERT_CHANNEL=telegram to use it instead.
ALERT_CHANNEL=email               # email | telegram
# Gmail: smtp.gmail.com, 587, STARTTLS. ALERT_EMAIL_PASSWORD must be a Gmail
# App Password (https://myaccount.google.com/apppasswords), not the account
# password — Gmail has rejected plain account passwords for SMTP since 2022.
ALERT_EMAIL_HOST=smtp.gmail.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TO=

# --- Stage 2+: not needed yet -------------------------------------------------
FEATURE_STORE_BACKEND=parquet     # parquet | hopsworks
HOPSWORKS_API_KEY=
HOPSWORKS_PROJECT=
HF_TOKEN=

# --- Stage 4+: the briefing layer must degrade without this -------------------
LLM_API_KEY=
LLM_PROVIDER=groq                 # groq | gemini | hf
