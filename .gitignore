# Secrets â€” I9
.env
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Notebook outputs are never committed (CLAUDE.md Â§16)
.ipynb_checkpoints/

# Local working data. NOTE the exceptions: the ledger IS committed â€” it is the
# honesty infrastructure (I3) and losing it is unrecoverable.
data/*
!data/ledger/
!data/ledger/**

# ADR-014: the Parquet feature store fallback commits inside the repo until
# an HF_TOKEN + dataset repo exist â€” same reasoning as the ledger, minus the
# irrecoverability (this one can be rebuilt from the backfill/feature
# pipeline if it's ever lost, just not for free).
!data/feature_store/
!data/feature_store/**
!data/backfill_manifest.jsonl

# Raw payloads split by whether they can be fetched again (ADR-006).
# AQICN raw is irreplaceable â€” there is no history endpoint, and each CI run is
# a fresh container, so anything not committed is gone. Commit it.
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/raw/aqicn/
!data/raw/aqicn/**

# Open-Meteo raw is a re-fetchable convenience cache. Keep it local.
data/raw/open_meteo/

# Generated artifacts are committed (I5: report numbers come from these),
# but local scratch is not.
reports/**/*.tmp

# Downloaded archives
*.tar.gz

# Derived feature store — regenerable via 'make backfill' (ADR-006)
data/feature_store/
